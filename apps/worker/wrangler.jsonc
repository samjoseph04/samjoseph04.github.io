{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sam-joseph-private-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../admin/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "portfolio-drafts", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "portfolio-private-uploads" }],
  "vars": {
    "ADMIN_ORIGIN": "https://REPLACE_WITH_PRIVATE_ADMIN_HOSTNAME",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE",
    "GITHUB_OWNER": "samjoseph04",
    "GITHUB_REPO": "samjoseph04.github.io",
    "GITHUB_BRANCH": "REPLACE_WITH_CONFIRMED_DEPLOYMENT_BRANCH"
  }
}
